# Deployment mode. Pick exactly one engine.
#   one GPU:  COMPOSE_PROFILES=gpu
#   two GPUs: COMPOSE_PROFILES=gpu,gpu1
#   cpu:      COMPOSE_PROFILES=cpu   (flash and basic only)
#   external: leave COMPOSE_PROFILES empty and set MINERU_BASE_URL(S) to an existing MinerU 4.0.
# Never set cpu and gpu together. Two GPUs are two MinerU containers, one card each.
# One Router that sees both cards keeps a single reconciler on one card.
COMPOSE_PROFILES=gpu

# One GPU, or cpu. Two GPUs: leave this and set MINERU_BASE_URLS instead.
MINERU_BASE_URL=http://mineru-router:8002
# Two GPUs on this machine, same order as the containers:
# MINERU_BASE_URLS=http://mineru-gpu0:8002,http://mineru-gpu1:8002
# Several machines, comma separated. Overrides MINERU_BASE_URL.
# MINERU_BASE_URLS=http://10.0.0.11:8002,http://10.0.0.12:8002
# MINERU_API_KEY=

# gpu profile.
# standard serves every tier and downloads VLM weights. basic suits small GPUs.
MINERU_GPU_TIER=standard
# In-flight jobs inside each MinerU container. Each container sees one GPU.
MINERU_GPU_CONCURRENCY=2
# Two GPUs: one slot count per address, same order as MINERU_BASE_URLS.
# THINKPARSE_SLOTS=2,2
# MINERU_SHM_SIZE=32gb

# cpu profile. One worker; raise only with spare cores and memory.
MINERU_CPU_CONCURRENCY=1

# Image build sources. Defaults are the global registries.
# In mainland China, for example:
#   MINERU_GPU_BASE_IMAGE=docker.m.daocloud.io/vllm/vllm-openai:v0.21.0
#   MINERU_CPU_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
#   CONTROL_BASE_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
# MINERU_DOWNLOAD_SOURCE=modelscope   # or huggingface

# ThinkParse.
THINKPARSE_PORT=8000
THINKPARSE_MAX_INFLIGHT=4
# Slots per MinerU address. Unset: each address uses THINKPARSE_MAX_INFLIGHT.
# One GPU: THINKPARSE_SLOTS equals MINERU_GPU_CONCURRENCY.
# Two GPUs: a comma list in the same order as MINERU_BASE_URLS, for example 2,2.
# THINKPARSE_SLOTS=2
# In-flight source bytes across all MinerU jobs. Default 1 GiB.
# THINKPARSE_INFLIGHT_BYTE_LIMIT=1073741824
# Delete finished-task objects after this many seconds.
# Clients such as ThinkExtract read the result while polling, so one hour is enough.
# Raise this if callers may refetch later. Set 0 to keep until the volume is removed.
# Uploads that never become a task are removed after 1 hour either way.
RESULT_EXPIRES_SECONDS=3600
# MinerU container scratch: worker blobs and the router source copy.
# ThinkParse deletes these after the zip is stored. This is the backstop.
# Default 6 hours. 0 keeps scratch until the MinerU process exits.
MINERU_FILE_RETENTION_SECONDS=21600
# Bearer key for /api/v2. /api/v1 stays open for 1.x clients.
# THINKPARSE_API_KEY=
# Restrict offered tiers further. Default: whatever MinerU reports.
# THINKPARSE_ACCEPTED_TIERS=flash,basic
# LEGACY_ALLOW_FLASH=false
# DOCLING_BASE_URL=

# Object bytes. Compose mounts one volume on the gateway and the reconciler.
# Leave the endpoint empty on a single host. Several hosts need one external S3.
# THINKPARSE_S3_ENDPOINT=https://s3.example.com
# THINKPARSE_S3_ACCESS_KEY=
# THINKPARSE_S3_SECRET_KEY=
# THINKPARSE_S3_BUCKET=thinkparse

# Change this before exposing the host. Use letters and digits only.
POSTGRES_PASSWORD=thinkparse
