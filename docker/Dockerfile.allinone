# ThinkParse all-in-one GPU image: Redis + API + Worker + Cleanup in one container.
# For schedulers (e.g. Tianhe) that accept a single container only.
# Default production topology remains docker-compose.yml (four containers).

FROM mineru-vllm:latest

ARG PIP_INDEX_URL=https://pypi.org/simple

# Prevent apt from trying to start Redis during image build.
RUN printf '#!/bin/sh\nexit 101\n' > /usr/sbin/policy-rc.d && chmod +x /usr/sbin/policy-rc.d

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        redis-server \
        supervisor \
        curl && \
    rm -f /usr/sbin/policy-rc.d && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /app /data/redis /tmp/mineru_temp /tmp/mineru_output \
             /var/log/supervisor /var/run

WORKDIR /app

COPY worker/requirements.txt /app/worker/requirements.txt
COPY api/requirements.txt /app/api/requirements.txt
COPY cleanup/requirements.txt /app/cleanup/requirements.txt
RUN python3 -m pip install --no-cache-dir \
        -r /app/worker/requirements.txt \
        -r /app/api/requirements.txt \
        -r /app/cleanup/requirements.txt \
        -i ${PIP_INDEX_URL} --break-system-packages && \
    python3 -m pip cache purge

COPY shared /app/shared
COPY api /app/api
COPY worker /app/worker
COPY cleanup /app/cleanup
COPY docker/entrypoint-allinone.sh /usr/local/bin/entrypoint-allinone.sh
COPY docker/supervisord.allinone.conf /etc/supervisor/supervisord.allinone.conf

RUN chmod +x /usr/local/bin/entrypoint-allinone.sh

ENV PYTHONPATH=/app \
    PYTHONUNBUFFERED=1 \
    MINERU_MODEL_SOURCE=local \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    REDIS_URL=redis://127.0.0.1:6379/0 \
    TEMP_DIR=/tmp/mineru_temp \
    OUTPUT_DIR=/tmp/mineru_output

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health/live || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint-allinone.sh"]
