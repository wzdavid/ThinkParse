FROM mineru-vllm:latest

ARG PIP_INDEX_URL=https://pypi.org/simple

WORKDIR /app

COPY worker/requirements.txt /app/worker/requirements.txt
RUN python3 -m pip install --no-cache-dir -r /app/worker/requirements.txt -i ${PIP_INDEX_URL} --break-system-packages

COPY shared /app/shared
COPY worker /app/worker

ENV PYTHONPATH=/app \
    MINERU_MODEL_SOURCE=local

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import os, redis; r = redis.from_url(os.environ['REDIS_URL']); assert r.get('thinkparse:worker:' + os.environ.get('WORKER_NAME', 'mineru-worker'))" || exit 1

CMD ["python3", "worker/tasks.py"]
